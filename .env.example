# Copy to .env (never commit it) or set these in Vercel → Project → Settings → Environment Variables.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
# Neon / Vercel Postgres pooled URL. Locally, leave unset to use the local database `sy_os`.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# Extra hosts if you add a custom domain (comma separated)
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=
# 1 only for a sample-data demo: shows demo logins on the login page and allows seed_demo
SYOS_DEMO=0
